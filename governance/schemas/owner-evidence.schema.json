{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hhy.owner-evidence/v5.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "frozen_commit",
    "result",
    "verified_at",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "hhy.owner-evidence/v5.0"
    },
    "release": {
      "type": "string",
      "pattern": "^R(?:0[1-9]|[12][0-9]|3[0-2])$"
    },
    "frozen_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "verified_at": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
