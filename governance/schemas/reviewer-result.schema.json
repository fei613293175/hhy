{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hhy.reviewer-result/v5.0",
  "type": "object",
  "required": ["schema", "status", "task_id", "commit", "summary", "findings"],
  "properties": {
    "schema": {"type": "string", "const": "hhy.reviewer-result/v5.0"},
    "status": {"type": "string", "enum": ["PASS", "BLOCK"]},
    "task_id": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "path", "line", "issue", "evidence", "requirement_ref"],
        "properties": {
          "severity": {"type": "string", "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]},
          "path": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "issue": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "requirement_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
