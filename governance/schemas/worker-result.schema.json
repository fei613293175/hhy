{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hhy.worker-result/v5.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "task_id",
    "summary",
    "changed_files",
    "commands_run",
    "error_fingerprint",
    "blocker"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "hhy.worker-result/v5.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE_READY",
        "DEVELOPMENT_RETRY",
        "ATTEMPT_FAILED",
        "EXTERNAL_BLOCKED",
        "INFRASTRUCTURE_BLOCKED"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocker": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "worker_result_evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "detail",
        "resolution",
        "paths",
        "worker_result_evidence"
      ],
      "additionalProperties": false
    }
  }
}
