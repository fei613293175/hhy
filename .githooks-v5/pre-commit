#!/usr/bin/env sh
set -eu
ROOT=$(git rev-parse --show-toplevel)
ROLE=${HHY_GOVERNANCE_ROLE:-HUMAN}
if [ "$ROLE" = "WORKER" ]; then
  echo "Governance V5: Worker cannot commit." >&2
  exit 1
fi
if [ -n "${HHY_PYTHON:-}" ]; then
  "$HHY_PYTHON" "$ROOT/tools/governance/hhy_governance.py" doctor
elif command -v py.exe >/dev/null 2>&1; then
  py.exe -3 "$ROOT/tools/governance/hhy_governance.py" doctor
elif command -v python.exe >/dev/null 2>&1; then
  python.exe "$ROOT/tools/governance/hhy_governance.py" doctor
else
  python3 "$ROOT/tools/governance/hhy_governance.py" doctor
fi
