+  - CURRENT_STATUS.yaml
+  - NEXT_TASK.yaml
+  - artifacts/context/**
+  - artifacts/handoffs/**
+mandatory_records:
+  every_project_change:
+  - active_session_machine_record
+  - session_log
+  - checkpoint
+  - CURRENT_STATUS.yaml
+  - EVENT_LOG.jsonl
+  - Context Pack
+  source_of_truth_change:
+  - approved_change_request
+  - updated_traceability
+  - updated_tests
+  bugfix:
+  - problem_registry
+  - regression_test
+forbidden:
+- 未领取任务直接编辑项目内容
+- 同一任务或Story存在两个ACTIVE领取
+- 检查点之后继续修改却直接提交
+- 只提交部分项目变更，留下无法解释的本地差异
+- 冻结事实变化没有已批准CR
+- Bug修复没有根因登记和回归测试
