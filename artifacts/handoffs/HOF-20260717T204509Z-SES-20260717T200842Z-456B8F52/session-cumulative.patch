+  preferred_agents:
+  - backend_data_high_reasoning
+  - admin_client
+  - security_quality
+- lane: GOVERNANCE-INTEGRATION
+  task_id: TASK-R03-005
+  stories:
+  - STORY-R03-004
+  outcome: 三切片共享迁移、权限、SecretRef、审计、18项测试、故障注入和生成物汇合
+  preferred_agents:
+  - coordinator
+integration:
+  task_id: TASK-R03-005
+  depends_on:
+  - TASK-R03-002
+  - TASK-R03-003
+  - TASK-R03-004
+  profiles:
+  - MODULE
+  - INTEGRATION
+external_activation:
+  task_id: TASK-R03-007
+  apk_required: true
+  required_evidence:
