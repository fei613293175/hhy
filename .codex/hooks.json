{
  "description": "HHY Governance V5.0 bounded Worker enforcement",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$r=(git rev-parse --show-toplevel); py -3 (Join-Path $r '.codex/hooks/session_start.py')\"",
            "additionalContextLimit": 1400,
            "timeout": 10,
            "statusMessage": "Loading bounded active task"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_guard.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$r=(git rev-parse --show-toplevel); py -3 (Join-Path $r '.codex/hooks/pre_tool_guard.py')\"",
            "timeout": 10,
            "statusMessage": "Enforcing Worker authority boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_watchdog.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$r=(git rev-parse --show-toplevel); py -3 (Join-Path $r '.codex/hooks/post_tool_watchdog.py')\"",
            "timeout": 15,
            "statusMessage": "Checking bounded progress"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_validate.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$r=(git rev-parse --show-toplevel); py -3 (Join-Path $r '.codex/hooks/stop_validate.py')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
