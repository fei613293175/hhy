{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbexa.cc/schemas/r01-test-evidence-v1.json",
  "title": "R01 Maven PostgreSQL 17 real API test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "report_id", "suite", "producer", "generated_at",
    "source_commit", "command", "environment", "results"
  ],
  "properties": {
    "schema": { "const": "hhy.r01.test-evidence/v1" },
    "report_id": { "type": "string", "minLength": 1 },
    "suite": { "const": "r01-backend-maven-pg17-real-api" },
    "producer": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_commit": { "type": "string", "pattern": "^[0-9A-Fa-f]{40,64}$" },
    "command": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["java", "maven", "postgresql", "api_base_url"],
      "properties": {
        "java": { "type": "string", "minLength": 1 },
        "maven": { "type": "string", "minLength": 1 },
        "postgresql": { "type": "string", "pattern": "(^|[^0-9])17([^0-9]|$)" },
        "api_base_url": { "type": "string", "format": "uri", "minLength": 1 }
      }
    },
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id", "status", "executed", "exit_code", "started_at",
          "finished_at", "assertions", "artifacts", "details"
        ],
        "properties": {
          "test_id": {
            "enum": [
              "TST-ADMIN_SECURITY_001-HAPPY",
              "TST-ADMIN_SECURITY_001-REJECT",
              "TST-ADMIN_SECURITY_001-SECURITY"
            ]
          },
          "status": { "enum": ["PASS", "FAIL", "N/A", "NOT_RUN"] },
          "executed": { "type": "boolean" },
          "exit_code": { "type": "integer" },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time" },
          "assertions": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "status"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "status": { "enum": ["PASS", "FAIL"] }
              }
            }
          },
          "artifacts": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
              }
            }
          },
          "details": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
